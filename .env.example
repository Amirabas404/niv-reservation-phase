# ===== Application =====
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql+asyncpg://niv:niv_password@localhost:5432/niv

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Internal auth between bots/worker and Backend =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=change-me

# ===== Receipt storage (private S3-compatible bucket, e.g. Cloudflare R2) =====
# Left empty until Phase 2 wiring. Never expose the bucket publicly.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Private receipt storage (local dev; R2 adapter comes before production) =====
PRIVATE_STORAGE_DIR=./private_storage

# ===== Management bot -> Backend (separate from customer token) =====
ADMIN_SERVICE_TOKEN=change-me-admin
MANAGEMENT_BOT_BACKEND_URL=http://localhost:8000
# Telegram ID of a manager; the notifier uses it to read the team and ticket queue
NOTIFIER_ACTOR_TELEGRAM_ID=123456789

# ===== Customer bot =====
BACKEND_URL=http://localhost:8000

# ===== Telegram =====
CUSTOMER_BOT_TOKEN=
MANAGEMENT_BOT_TOKEN=

# ===== Storage provider: local (dev) or r2 (production, private bucket) =====
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=niv-private
# STORAGE_ACCESS_KEY=...
# STORAGE_SECRET_KEY=...

# ===== Backups =====
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=30

# ===== Webhooks (production). Leave WEBHOOK_BASE_URL empty for polling in development. =====
# WEBHOOK_BASE_URL=https://<your-railway-domain>
# WEBHOOK_SECRET=generate-a-long-random-value
